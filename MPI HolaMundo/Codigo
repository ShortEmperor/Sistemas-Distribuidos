# hola_mpi.py
from mpi4py import MPI

# Inicializar el comunicador
comm = MPI.COMM_WORLD
# Obtener el rango del proceso actual
rank = comm.Get_rank()
# Obtener el número total de procesos
size = comm.Get_size()

print(f"Hola Mundo desde el proceso {rank} de {size}")



//ejecutar

mpirun -np 4 python hola_mpi.py


mpirun -np 2 --hostfile hosts.txt python3 hola_mpi.py


mpirun --mca btl_tcp_if_include eth0 -np 2 --hostfile hosts.txt python3 hola_mpi.py

mpirun --mca btl_tcp_if_include lo -np 2 --hostfile hosts.txt python3 hola_mpi.py
mpirun --display-map -np 2 --hostfile hosts.txt python3 hola_mpi.py
